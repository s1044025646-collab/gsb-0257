{
  "name": "frac-approx",
  "version": "1.0.0",
  "description": "有限分母分数近似与连分数解释后端（TypeScript + Node + SQLite）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "frac-approx": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/src/test/*.test.js\"",
    "demo": "tsc -p tsconfig.json && node dist/scripts/demo.js",
    "cli": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
